# =========================================================
# EXAMORA
# Git Ignore Configuration
# =========================================================

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
.venv/
env/
ENV/

# Environment variables
.env

# Uploaded files
uploads/*
!uploads/.gitkeep

# Generated extracted data
data/extracted/*
!data/extracted/.gitkeep

# Generated processed data
data/processed/*
!data/processed/.gitkeep

# Test cache
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Python build files
build/
dist/
*.egg-info/